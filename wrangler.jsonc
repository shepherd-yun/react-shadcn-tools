{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-shadcn-tools",
  "compatibility_date": "2026-10-06",
  "routes": [
    { "pattern": "tools.shepherdyun.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
